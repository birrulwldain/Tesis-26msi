  \fancyfoot[C]{\thepage}
  \renewcommand{\headrulewidth}{0.0pt}
  \renewcommand{\footrulewidth}{0.0pt}
}

% Pagestyle plain (dipakai oleh beberapa halaman default) - selaraskan dengan fancy (nomor di kanan bawah)
\fancypagestyle{plain}{%
  \fancyhf{}%
  \fancyhead{} % Pastikan header kosong
  \fancyfoot{} % Bersihkan footer dulu
  \fancyfoot[R]{\thepage}% Nomor halaman di kanan bawah
  \renewcommand{\headrulewidth}{0pt}%
