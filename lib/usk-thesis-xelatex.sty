% Custom algorithm environment
\newenvironment{algoritma}{\begin{algorithm}}{\end{algorithm}}
\floatname{algorithm}{Algoritma}

% Hapus spacing ekstra antar chapter di LOF dan LOT
\patchcmd{\@chapter}{\addtocontents{lof}{\protect\addvspace{10\p@}}}{}{}{} 
\patchcmd{\@chapter}{\addtocontents{lot}{\protect\addvspace{10\p@}}}{}{}{} 

% Command untuk enable/disable bold chapter di TOC
\newcommand*{\enableboldchapterintoc}{%
  \addtocontents{toc}{\string\renewcommand{\protect\cftchapfont}{\protect\normalfont\protect\bfseries}}%
  \addtocontents{toc}{\protect\setlength{\cftbeforechapskip}{12pt}}%
  % Indent BAB dari margin kiri, hilangkan dots dan page number
  \addtocontents{toc}{\string\cftsetindents{chapter}{1.5em}{4.5em}}%
  \addtocontents{toc}{\string\renewcommand{\protect\cftchapleader}{\protect\hfill}}%
  \addtocontents{toc}{\string\renewcommand{\protect\cftchappagefont}[1]{}}%
}
\newcommand*{\disableboldchapterintoc}{%
  \addtocontents{toc}{\string\renewcommand{\protect\cftchapfont}{\protect\normalfont}}%
  \addtocontents{toc}{\protect\setlength{\cftbeforechapskip}{0pt}}%
  % Restore dots dan page number
  \addtocontents{toc}{\string\renewcommand{\protect\cftchapleader}{\protect\cftdotfill{\protect\cftdotsep}}}%
  \addtocontents{toc}{\string\renewcommand{\protect\cftchappagefont}{\protect\normalfont}}%
}

% Command baru untuk DAFTAR KEPUSTAKAAN dan LAMPIRAN
% Format: bold, indent 1.5em, DENGAN dots dan page number
\newcommand*{\specialchapterintoc}{%
  \addtocontents{toc}{\string\renewcommand{\protect\cftchapfont}{\protect\normalfont\protect\bfseries}}%
  \addtocontents{toc}{\protect\setlength{\cftbeforechapskip}{12pt}}%
  % Indent 1.5em, dengan dots dan page number
  \addtocontents{toc}{\string\cftsetindents{chapter}{1.5em}{4.5em}}%
  \addtocontents{toc}{\string\renewcommand{\protect\cftchapleader}{\protect\cftdotfill{\protect\cftdotsep}}}%
  \addtocontents{toc}{\string\renewcommand{\protect\cftchappagefont}{\protect\normalfont}}%
}

% Kerapatan dots (0.5 = rapat)
\renewcommand{\cftdotsep}{0.5}

% Chapter: dengan dots dan BOLD
\renewcommand{\cftchapleader}{\cftdotfill{\cftdotsep}}
\renewcommand{\cftchapfont}{\normalfont\bfseries}
\renewcommand{\cftchappagefont}{\normalfont\bfseries}

% Spacing antar baris di TOC
\setlength{\cftbeforechapskip}{0pt}  % Default: 0pt (untuk preliminary)
\setlength{\cftbeforesecskip}{0pt}   % Spacing sebelum section
\setlength{\cftbeforesubsecskip}{0pt} % Spacing sebelum subsection
% Pastikan tidak ada \parskip ekstra antar entri di TOC/LOF/LOT
\setlength{\cftparskip}{0pt}

% --- Spasi vertikal antar entri (diperapat) ---
\setlength{\cftbeforefigskip}{0pt}% lebih rapat antar entri gambar
\setlength{\cftbeforetabskip}{0pt}% lebih rapat antar entri tabel

% --- Prefix/label nomor dengan titik ---
\renewcommand{\cftfigpresnum}{Gambar\ }
\renewcommand{\cftfigaftersnum}{.\ }% Tambah titik setelah nomor
\renewcommand{\cfttabpresnum}{Tabel\ }
\renewcommand{\cfttabaftersnum}{.\ }% Tambah titik setelah nomor

% --- Lebar kolom nomor (disesuaikan untuk 1 spasi natural setelah titik) ---
\setlength{\cftfignumwidth}{5em}
\setlength{\cfttabnumwidth}{4em}

% --- Indent: 0 = rata kiri ---
\setlength{\cftfigindent}{0pt}
\setlength{\cfttabindent}{0pt}

% --- Font dan leader dots ---
\renewcommand{\cftfigfont}{\normalfont}
\renewcommand{\cfttabfont}{\normalfont}
\renewcommand{\cftfigpagefont}{\normalfont}
\renewcommand{\cfttabpagefont}{\normalfont}
\renewcommand{\cftfigleader}{\cftdotfill{\cftdotsep}}
\renewcommand{\cfttableader}{\cftdotfill{\cftdotsep}}

% --- Spasi setelah nomor halaman ---
\renewcommand{\cftfigafterpnum}{\vskip0pt}
\renewcommand{\cfttabafterpnum}{\vskip0pt}

% Prefix untuk Chapter
\renewcommand\cftchappresnum{BAB } 

% Indentasi dan width
\cftsetindents{chapter}{0em}{4.5em}
\cftsetindents{section}{4.5em}{2em}
\cftsetindents{subsection}{6.5em}{3em}

% Suffix titik untuk section dan subsection
\renewcommand{\cftsecaftersnum}{.}
\renewcommand{\cftsubsecaftersnum}{.}

% Header "Halaman" di kanan atas TOC/LOF/LOT
\AtBeginDocument{%
  \addtocontents{toc}{~\hfill \textit{Halaman}\par}%
  \addtocontents{lof}{~\hfill \textit{Halaman}\par}%
  \addtocontents{lot}{~\hfill \textit{Halaman}\par}%
  \addtocontents{apc}{~\hfill \textit{Halaman}\par}%
}

% Wrapper untuk TOC/LOF/LOT dengan singlespacing dan judul KAPITAL (seperti contoh.tex)
\let\originaltableofcontents\tableofcontents
\renewcommand{\tableofcontents}{%
  \pagestyle{preliminarypage}%
  \prelimchapter{DAFTAR ISI}%
  \begin{singlespace}%
    \@starttoc{toc}%
  \end{singlespace}%
}

% LOF dan LOT dibungkus dengan singlespace environment (seperti contoh.tex)
\let\originallistoffigures\listoffigures
\renewcommand{\listoffigures}{%
  \pagestyle{preliminarypage}%
  \prelimchapter{DAFTAR GAMBAR}%
  \begin{singlespace}%
    \begingroup
      \let\orig@addvspace\addvspace
      \renewcommand{\addvspace}[1]{}%
      \@starttoc{lof}%
    \endgroup
  \end{singlespace}%
}

\let\originallistoftables\listoftables
\renewcommand{\listoftables}{%
  \pagestyle{preliminarypage}%
  \prelimchapter{DAFTAR TABEL}%
  \begin{singlespace}%
    \begingroup
      \let\orig@addvspace\addvspace
      \renewcommand{\addvspace}[1]{}%
      \@starttoc{lot}%
    \endgroup
  \end{singlespace}%
}

