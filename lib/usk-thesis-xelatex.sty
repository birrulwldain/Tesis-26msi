% Spacing antara nomor section dan judul (1 spasi)
\renewcommand{\@seccntformat}[1]{\csname the#1\endcsname\ }

% Chapter formatting
\renewcommand{\chapter}{\clearpage\thispagestyle{chapterheading}%
  \global\@topnum\z@ % Prevents figures from going at top of page
  \@afterindenttrue % Indent the 1st paragraph
  \secdef\@chapter\@schapter}

% Numbering for equations, figures, tables
\@addtoreset{equation}{chapter}
\renewcommand\theequation{\ifnum\c@chapter>\z@\@arabic\c@chapter.\fi\@arabic\c@equation}
\renewcommand\thefigure{\ifnum\c@chapter>\z@\@arabic\c@chapter.\fi\@arabic\c@figure}
\renewcommand\thetable{\ifnum\c@chapter>\z@\@arabic\c@chapter.\fi\@arabic\c@table}

%==============================================================================
% 6. PENOMORAN DAN STRUKTUR CHAPTER/SECTION
%==============================================================================

\setcounter{secnumdepth}{2}

% Penomoran menggunakan Romawi untuk chapter
\renewcommand{\thechapter}{\@Roman\c@chapter}
\renewcommand{\thesection}{\@arabic\c@chapter.\@arabic\c@section}
\renewcommand{\thesubsection}{\@arabic\c@chapter.\@arabic\c@section.\@arabic\c@subsection}

% Chapter
\renewcommand{\chapter}{%
  \clearpage\thispagestyle{chapterheading}%
  \global\@topnum\z@
  \@afterindenttrue
  \secdef\@chapter\@schapter
}

% Custom command untuk preliminary chapter (chapter* tanpa chapterheading)
\newcommand{\prelimchapter}[1]{%
  \clearpage
  \@makeschapterhead{#1}%
  \@afterheading
}

\renewcommand{\@makechapterhead}[1]{%
  {\parindent \z@ \centering \normalfont
    \ifnum \c@secnumdepth >\m@ne
      \large\bfseries \MakeUppercase{\@chapapp}\space \thechapter
      \par\nobreak
      \vskip -0.2cm
    \fi
    \interlinepenalty\@M
    \large\bfseries \MakeUppercase{#1}\par\nobreak
    \vskip 5.25ex plus 1ex minus 0.5ex
  }
}

\renewcommand{\@makeschapterhead}[1]{%
  {\parindent \z@ \centering \normalfont
    \interlinepenalty\@M
    \large\bfseries \MakeUppercase{#1}\par\nobreak
    \vskip 5.25ex plus 1ex minus 0.5ex
  }
}

% Section - judul KAPITAL di halaman, normal di TOC
% Spacing: dari paragraf ke section, dari section ke paragraf
% Nilai positif pada spacing sebelum = paragraf setelah section AKAN ter-indent
\renewcommand{\section}{%
  \@startsection{section}{1}{\z@}%
    {3.5ex \@plus 1ex \@minus .2ex}% spacing sebelum section (POSITIF = indent paragraf setelah)
    {0.5ex \@plus.2ex}% spacing setelah section
    {\normalfont\normalsize\bfseries\MakeUppercase}
}

% Subsection (subjudul)
% Spacing: 3 spasi sebelum (dari paragraf), 1.5 spasi setelah (ke paragraf)
% Nilai positif = paragraf setelah subsection AKAN ter-indent
\renewcommand{\subsection}{%
  \@startsection{subsection}{2}{\z@}%
    {3.5ex \@plus 1ex \@minus .2ex}% 3 spasi sebelum (POSITIF = indent paragraf setelah)
    {0.5ex \@plus.2ex}% spacing setelah
    {\normalfont\normalsize\bfseries}
}

% Subsubsection (subsubjudul)
% Spacing: 1.5 spasi sebelum (dari paragraf), 1.5 spasi setelah (ke paragraf)
% Nilai positif = paragraf setelah subsubsection AKAN ter-indent
\renewcommand{\subsubsection}{%
  \@startsection{subsubsection}{3}{\z@}%
    {2ex \@plus 0.5ex \@minus .2ex}% 1.5 spasi sebelum (POSITIF = indent paragraf setelah)
    {0.5ex \@plus.2ex}% 1.5 spasi setelah
    {\normalfont\normalsize\bfseries}
}

% Persamaan, gambar, tabel
\@addtoreset{equation}{chapter}
\renewcommand{\theequation}{%
  \ifnum \c@chapter>\z@ \@arabic\c@chapter.\fi \@arabic\c@equation
}
\renewcommand{\thefigure}{%
  \ifnum \c@chapter>\z@ \@arabic\c@chapter.\fi \@arabic\c@figure
}
\renewcommand{\thetable}{%
  \ifnum \c@chapter>\z@ \@arabic\c@chapter.\fi \@arabic\c@table
}

%==============================================================================
% 6B. CUSTOM APPENDIX FORMAT
%==============================================================================

% Override \appendix untuk format lampiran custom
\let\oldappendix\appendix
\renewcommand{\appendix}{%
  \oldappendix
  \renewcommand{\@chapapp}{Lampiran}%
  % Penomoran lampiran: 1, 2, 3, dst (bukan A, B, C)
  \renewcommand\thechapter{\@arabic\c@chapter}%
  % Penomoran equation, figure, table dalam lampiran: L.1.1, L.2.1, dst
  \renewcommand{\theequation}{L.\thechapter.\arabic{equation}}%
  \renewcommand{\thefigure}{L.\thechapter.\arabic{figure}}%
  \renewcommand{\thetable}{L.\thechapter.\arabic{table}}%
  % Jangan tambahkan gambar/tabel lampiran ke Daftar Gambar/Tabel
  \captionsetup[figure]{list=no}%
  \captionsetup[table]{list=no}%
  % Penomoran section dalam lampiran: L.2.1 (untuk Lampiran 2, section 1)
  \renewcommand\thesection{L.\thechapter.\@arabic\c@section}%
  % Nonaktifkan subsection (set tocdepth dan secnumdepth)
  \setcounter{secnumdepth}{1}% Hanya chapter dan section yang diberi nomor
  % Format chapter heading untuk lampiran: rata kiri, bold 12pt
  \renewcommand{\@makechapterhead}[1]{%
    {\parindent \z@ \raggedright \normalfont
      \ifnum \c@secnumdepth >\m@ne
        \normalsize\bfseries \@chapapp\space \thechapter. ##1
        \par\nobreak
        \vskip 5.25ex plus 1ex minus 0.5ex
      \fi
    }%
  }%
  % Format section dalam lampiran: tidak KAPITAL, hanya huruf pertama kapital
  \renewcommand{\section}{%
    \@startsection{section}{1}{\z@}%
      {3.5ex \@plus 1ex \@minus .2ex}%
      {0.5ex \@plus.2ex}%
      {\normalfont\normalsize\bfseries}% Tanpa \MakeUppercase
  }%
  % Override \appendices untuk menampilkan "Lampiran X. Judul" di Daftar Lampiran
  \renewcommand{\appendices}[1]{%
    \addcontentsline{apc}{appendices}{\protect\numberline{Lampiran \thechapter.}##1}%
  }%
}

