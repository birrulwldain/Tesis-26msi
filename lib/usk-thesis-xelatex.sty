%==============================================================================
% USK THESIS PACKAGE FOR XELATEX
%==============================================================================
% XeLaTeX-optimized package untuk penulisan tugas akhir di Universitas Syiah Kuala
% Format: LaTeX 2e (.sty - Style Package) untuk XeLaTeX
%
% @author Abdul Hafidh, Birrul Walidain
% @date 2025
% @version 2.1
%
% Deskripsi:
%   Paket ini dioptimalkan untuk XeLaTeX dengan dukungan penuh:
%   - Unicode support native
%   - Fontspec untuk font selection
%   - Tidak perlu inputenc (XeLaTeX handles UTF-8 natively)
%   - Better OpenType font support
%
% Penggunaan:
%   xelatex skripsi.tex
%   (tidak perlu pdflatex)
%
% Opsi paket:
%   - proposal: Untuk proposal penelitian
%   - hasil: Untuk laporan hasil
%   - skripsi: Untuk skripsi lengkap (default)
%   - indonesia: Untuk bahasa Indonesia (default)
%   - inggris: Untuk bahasa Inggris
%
%==============================================================================

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{usk-thesis-xelatex}[2025/01/01 v2.1 USK Thesis Package for XeLaTeX]

%==============================================================================
% 1. OPSI PAKET & MODE PARAMETER
%==============================================================================

\newif\if@thesis
\newif\if@proposal
\newif\if@hasil
\newif\if@langindo
\newif\if@langeng

% Default values
\gdef\@thesismode{sidang}  % Default mode: sidang (skripsi)

% Option declarations
\DeclareOption{thesis}{\@thesistrue\@proposalfalse\@hasilfalse\gdef\@thesismode{sidang}}
\DeclareOption{proposal}{\@thesisfalse\@proposaltrue\@hasilfalse\gdef\@thesismode{sempro}}
\DeclareOption{hasil}{\@thesisfalse\@proposalfalse\@hasiltrue\gdef\@thesismode{semhas}}
\DeclareOption{sidang}{\@thesistrue\@proposalfalse\@hasilfalse\gdef\@thesismode{sidang}}
\DeclareOption{sempro}{\@thesisfalse\@proposaltrue\@hasilfalse\gdef\@thesismode{sempro}}
\DeclareOption{semhas}{\@thesisfalse\@proposalfalse\@hasiltrue\gdef\@thesismode{semhas}}

% Mode parameter support (simple flags-based handling)
% The package supports options: thesis / proposal / hasil / sidang / sempro / semhas
% and language options: indonesia / inggris. Unknown options are ignored.
\DeclareOption{indonesia}{\@langindotrue\@langengfalse}
\DeclareOption{inggris}{\@langindofalse\@langengtrue}

\ExecuteOptions{indonesia}
% Gracefully ignore unknown options (e.g., key-value style like mode=sempro)
\DeclareOption*{%
  \PackageWarning{usk-thesis-xelatex}{Unknown option `\CurrentOption' ignored}%
}
\ProcessOptions\relax

% Set mode based on the boolean flags set by the \DeclareOption calls above.
% Prefer explicit flags (proposal / hasil); otherwise default to sidang.
\if@proposal
  \gdef\@thesismode{sempro}%
  \@proposaltrue\@thesisfalse\@hasilfalse
\else
  \if@hasil
    \gdef\@thesismode{semhas}%
    \@proposalfalse\@thesisfalse\@hasiltrue
  \else
    \gdef\@thesismode{sidang}%
    \@thesistrue\@proposalfalse\@hasilfalse
  \fi
\fi

