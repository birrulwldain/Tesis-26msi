%==============================================================================
% 12. DEFAULT SPACING
%==============================================================================

\AtBeginDocument{%
  \onehalfspacing
  \if@langindo
    \selectlanguage{bahasai}%
  \else
    \selectlanguage{english}%
  \fi
  
  % Float spacing: Jarak paragraf ke gambar/tabel dan sebaliknya
  % textfloatsep: jarak antara float (top/bottom page) dengan teks = 3 spasi
  \setlength{\textfloatsep}{3.5ex plus 1ex minus 0.5ex}
  % intextsep: jarak antara teks dengan float yang berada di tengah teks = 3 spasi
  \setlength{\intextsep}{3.5ex plus 1ex minus 0.5ex}
  % floatsep: jarak antar float jika ada beberapa float berurutan = 3 spasi
  \setlength{\floatsep}{3.5ex plus 1ex minus 0.5ex}
  
  % Caption setup untuk figure dan table (dari contoh.tex)
  % Format: "Gambar 2.1. Caption teks" atau "Tabel 2.1. Caption teks"
  \captionsetup[figure]{%
    labelfont={normalfont},%
    textfont={normalfont},%
    singlelinecheck=true,%
    justification=raggedright,%
    labelsep=period,%  % Titik setelah nomor, lalu spasi
    format=hang,%
    indention=0pt,%
    skip=2ex%  % Jarak caption ke gambar = 1.5 spasi versi kita
  }
  \captionsetup[table]{%
    labelfont={normalfont},%
    textfont={normalfont},%
    singlelinecheck=true,%
    justification=raggedright,%
    labelsep=period,%  % Titik setelah nomor, lalu spasi
    format=hang,%
    indention=0pt,%
    skip=2ex%  % Jarak caption ke tabel = 1.5 spasi versi kita
  }
}

