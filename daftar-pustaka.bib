@article{idris_atomic_2005,
	title = {Atomic {Hydrogen} {Emission} {Induced} by {TEA} {CO}$_{\textrm{2}}$ {Laser} {Bombardment} on {Solid} {Samples} at {Low} {Pressure} and its {Analytical} {Application}},
