@article{idris_characteristics_2004-1,
	title = {Characteristics of {Hydrogen} {Emission} in {Laser} {Plasma} {Induced} by {Focusing} {Fundamental} {Q}-sw {YAG} {Laser} on {Solid} {Samples}},
